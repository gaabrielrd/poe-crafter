{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.cache/tsconfig.web-app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
